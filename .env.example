# Ollama
OLLAMA_HOST=http://localhost:11434
MODEL_CHAT=qwen2.5:7b-instruct
MODEL_EMBED=nomic-embed-text
MODEL_JUDGE=llama3.1:8b

# Paths (relative to repo root)
CORPUS_DIR=data
CHROMA_DIR=data/chroma
SQLITE_PATH=data/uniassist.db

# Retrieval
RETRIEVAL_K=5
RETRIEVAL_FETCH_K=20
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Scraper
SCRAPE_SEED_URL=https://www.sydney.edu.au/students/student-it.html
SCRAPE_MAX_PAGES=150
SCRAPE_MAX_DEPTH=2
SCRAPE_DELAY_SECONDS=1.0
SCRAPE_USER_AGENT=UniAssistBot/0.1 (+https://github.com/MRafagnin/uniassist)
